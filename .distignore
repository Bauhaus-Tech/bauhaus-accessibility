/.github
/.gitignore
/.distignore
/.wordpress-org
/README.md
/AGENTS.md
/PLAN.md
/bin
/build
/docs
/tests
/vendor
/composer.json
/composer.lock
/phpunit.xml.dist
/phpcs.xml.dist
/phpstan.neon.dist
/patchwork.json
/.phpunit.result.cache
*.zip
